    {
      "arquivo": "C:\\Users\\AZTEKA\\Videos\\Little-witch-in-the-woods-PT-BR-localization\\LW\\dialogos\\nao_revisados\\particionados\\nao_revisadas_parte_002.json",
      "parte": 2,
